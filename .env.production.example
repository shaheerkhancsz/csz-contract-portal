APP_NAME="CSZ Contract Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://contracts.creativesolutionzone.com
APP_TIMEZONE=Asia/Karachi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL database created in cPanel > MySQL Databases
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_contracts
DB_USERNAME=cpaneluser_contracts
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Outgoing mail (password resets + queued contract notifications).
# Notifications run on the database queue, drained by the per-minute schedule:run cron.
MAIL_MAILER=smtp
MAIL_HOST=mail.creativesolutionzone.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=info@creativesolutionzone.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@creativesolutionzone.com
MAIL_FROM_NAME="Creative Solution Zone"

# Staff must set up an authenticator app at first login
PORTAL_REQUIRE_2FA=true

# Online signing (Phase 2): link validity and email-OTP rules
SIGN_LINK_DAYS=14
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_PER_HOUR=5
# Reminders for contracts sent but not yet signed
SIGN_REMINDER_AFTER_DAYS=3
SIGN_REMINDER_INTERVAL_DAYS=3
SIGN_REMINDER_MAX=3

# WHMCS link (Phase 2). Create an API credential in WHMCS > Setup > Staff API and
# allow the GetClientsDetails action; add this server's IP to the API IP allowlist.
WHMCS_URL=https://clients.creativesolutionzone.com
WHMCS_API_IDENTIFIER=
WHMCS_API_SECRET=
WHMCS_ADMIN_URL=https://clients.creativesolutionzone.com/admin
WHMCS_TIMEOUT=10

# WHMCS SSO handoff into the client area. Generate a long random string and set the
# SAME value in the WHMCS hook that builds the signed /client/sso link.
WHMCS_SSO_SECRET=
CLIENT_SESSION_MINUTES=30
CLIENT_SSO_TTL=120

# First admin, created by: php artisan db:seed --force
ADMIN_NAME="Your Name"
ADMIN_EMAIL=you@creativesolutionzone.com
ADMIN_PASSWORD=
